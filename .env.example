# ---------------------------------------------------------------------------
# APAAR Student Governance Platform - local development configuration
# Copy to .env and change every value before exposing outside localhost.
# These are LOCAL-ONLY placeholders, not production credentials.
# ---------------------------------------------------------------------------

# PostgreSQL (container-internal; port is not published to the host)
POSTGRES_DB=apaar
POSTGRES_USER=apaar
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Java backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=demo
JWT_SECRET=change-me-local-only-32-bytes-minimum-secret-key
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AI_SERVICE_BASE_URL=http://ai-service:8000
FILE_UPLOAD_MAX_BYTES=5242880
DEMO_DATA_ENABLED=true

# Python AI service
AI_PORT=8000
AI_ENV=development
AI_MODEL_VERSION=0.1.0
AI_ANOMALY_THRESHOLD=0.65
LOG_LEVEL=INFO

# Frontend build (Vite reads VITE_*)
VITE_API_BASE_URL=/api/v1
VITE_SHOW_DEMO_HINT=true
FRONTEND_PORT=5173

# Demo-only credentials are documented in README; never reuse.
