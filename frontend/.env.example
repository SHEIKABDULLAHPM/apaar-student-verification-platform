# API base path. Keep it relative so the Vite dev proxy and the production
# nginx container can forward requests to the backend on the same origin.
VITE_API_BASE_URL=/api/v1

# One-click guest sign-in for the seeded demo roles is enabled by default and
# never renders passwords. Set to false to hide the guest panel entirely.
VITE_SHOW_DEMO_HINT=true
